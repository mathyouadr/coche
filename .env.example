# Copy this file to .env and adjust it. Every line is optional except the password.
# Keep comments on their own lines: Docker does not support "VALUE  # comment".

# --- Security --------------------------------------------------------------
# Web login, and API tokens become mandatory. Coche refuses to start while it is "change-me".
# Leave it empty only on a trusted network (or behind a proxy that does authentication).
COCHE_PASSWORD=change-me
# Set to 1 when Coche is served over HTTPS (Secure cookie).
# COCHE_SECURE_COOKIE=1
# Set to 1 behind a reverse proxy (real client IP for the login rate limit).
# COCHE_TRUST_PROXY=1

# Without a password, Coche only answers to IP addresses and localhost. Add the names you open it with:
# COCHE_ALLOWED_HOSTS=coche.lan,nas.local
# Extra API tokens, comma-separated (you can also create tokens in Settings).
# COCHE_TOKENS=

# --- Server ----------------------------------------------------------------
COCHE_HOST=0.0.0.0
COCHE_PORT=8043
# Time zone used for "today" and reminders.
COCHE_TZ=Europe/Paris
# Language of a new database: en, fr or en-us. Default: the browser's language.
# COCHE_LANG=fr
# Serve under a sub-path of a reverse proxy, e.g. /tasks
# COCHE_BASE_PATH=
# Where the database lives (the Docker image uses /data).
# COCHE_DATA_DIR=

# --- Reminders (pick one or more) -------------------------------------------
# ntfy topic: install the ntfy app and subscribe to the same secret topic.
# COCHE_NTFY_URL=https://ntfy.sh/my-very-secret-topic
# Any command; it receives the reminder as JSON on stdin.
# COCHE_NOTIFY_COMMAND=
# Webhook receiving every task event and reminder.
# COCHE_WEBHOOK_URL=
# COCHE_WEBHOOK_SECRET=

# --- Look & feel -----------------------------------------------------------
# COCHE_TITLE=Tasks
# Extra HTML in every page; prefix with @ to read a file (mount it in docker-compose.yml).
# COCHE_EXTRA_HEAD=@/config/head.html
# COCHE_EXTRA_BODY=@/config/body.html
